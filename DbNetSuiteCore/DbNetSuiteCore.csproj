<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <Description>Interactive data-driven components for ASP.Net Core Razor Views. Support for MSSQL, MySql, PostgreSql, Oracle, SQLite, JSON, Excel, CSV and the file system</Description>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Interactive data-driven components for ASP.Net Core Razor Views</Title>
    <NuspecFile>Nuget/dbnetsuitecore.nuspec</NuspecFile>
    <Authors>DbNetLink</Authors>
    <Copyright>Copyright (c) DbNetLink Limited 2024</Copyright>
    <PackageProjectUrl>https://dbnetsuitecore.com</PackageProjectUrl>
    <PackageIcon>nuget_logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/dbnetlink/DbNetSuiteCore2</RepositoryUrl>
    <PackageTags>asp.netcore;components;component;asp.net;core;razor;blazor;htmx;spreadsheet;excel grid;grid;csv grid;sqlite grid;mysql grid;mssql grid;postgresql grid;json grid;</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  
  

  <ItemGroup>
    <Content Include="build\$(PackageId).targets" Pack="true" PackagePath="buildTransitive\$(TargetFramework)\" />
    <Content Include="build\componentControl.d.ts" Pack="true" PackagePath="buildTransitive\$(TargetFramework)\" />
    <Content Include="build\gridControl.d.ts" Pack="true" PackagePath="buildTransitive\$(TargetFramework)\" />
    <Content Include="build\formControl.d.ts" Pack="true" PackagePath="buildTransitive\$(TargetFramework)\" />
    <Content Include="build\selectControl.d.ts" Pack="true" PackagePath="buildTransitive\$(TargetFramework)\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Resources\Blazor\**" />
    <Compile Remove="Resources\TS\**" />
    <Compile Remove="Utilities\**" />
    <Content Remove="Resources\Blazor\**" />
    <Content Remove="Resources\TS\**" />
    <Content Remove="Utilities\**" />
    <EmbeddedResource Remove="Resources\Blazor\**" />
    <EmbeddedResource Remove="Resources\TS\**" />
    <EmbeddedResource Remove="Utilities\**" />
    <None Remove="Resources\Blazor\**" />
    <None Remove="Resources\TS\**" />
    <None Remove="Utilities\**" />
    <TypeScriptCompile Remove="Resources\Blazor\**" />
    <TypeScriptCompile Remove="Resources\TS\**" />
  </ItemGroup>


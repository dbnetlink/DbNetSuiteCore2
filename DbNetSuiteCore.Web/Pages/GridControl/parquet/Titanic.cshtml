@page
@using DbNetSuiteCore.Enums
@using DbNetSuiteCore.Models
@using Microsoft.Extensions.Primitives

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    @DbNetSuiteCore.Resources.StyleSheet()
</head>
<body>
    <main>
        @{
            var port = Request.Query["port"] == StringValues.Empty ? new StringValues(string.Empty) : Request.Query["port"];

            var url = String.IsNullOrEmpty(port.ToString()) ? "/data/parquet/titanic.parquet" : $"https://localhost:{port}/data/parquet/titanic.parquet";
            var grid = new GridModel(DataSourceType.Parquet, url) { };
            @(await DbNetSuiteCore.Control.Create(HttpContext).Render(grid))
        }
    </main>
    @DbNetSuiteCore.Resources.ClientScript()
</body>
</html>


@page
@using DbNetSuiteCore.Enums
@using DbNetSuiteCore.Models


@{
    var columns = new List<GridColumn>
    {
        new GridColumn("row_id"){ Filter = FilterType.Default, DataType = typeof(int), PrimaryKey = true },
        new GridColumn("order_id"){ Filter = FilterType.Default },
        new GridColumn("order_date"){ Filter = FilterType.Default, DataType = typeof(DateTime) },
        new GridColumn("ship_date"){ DataType = typeof(DateTime) },
        new GridColumn("ship_mode") { Filter = FilterType.Distinct},
        new GridColumn("customer_id"),
        new GridColumn("customer_name"),
        new GridColumn("segment"){ Filter = FilterType.Distinct},
        new GridColumn("country"){ Filter = FilterType.Distinct},
        new GridColumn("city"){ Filter = FilterType.Distinct},
        new GridColumn("state"){ Filter = FilterType.Distinct},
        new GridColumn("postal_code") { DataType = typeof(String)},
        new GridColumn("region"){ Filter = FilterType.Distinct},
        new GridColumn("product_id"),
        new GridColumn("category"){ Filter = FilterType.Distinct},
        new GridColumn("subcategory"){ Filter = FilterType.Distinct},
        new GridColumn("product_name"),
        new GridColumn("sales") { Format = "c",Filter = FilterType.Default,DataType = typeof(Decimal) },
        new GridColumn("quantity") { Filter = FilterType.Distinct, DataType = typeof(int)},
        new GridColumn("discount") { Format = "p", Filter = FilterType.Default,DataType = typeof(Decimal)},
        new GridColumn("profit") { Format = "c", Filter = FilterType.Default,DataType = typeof(Decimal)}
    };

    var superstoreGrid = new GridModel(DataSourceType.Excel, $"/data/excel/superstore.xlsx") { Columns = columns, OptimizeForLargeDataset = true };
}

@(await DbNetSuiteCore.Control.Create(HttpContext).Render(superstoreGrid))

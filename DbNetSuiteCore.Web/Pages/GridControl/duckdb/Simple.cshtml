@page
@using DbNetSuiteCore.Enums
@using DbNetSuiteCore.Models

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    @DbNetSuiteCore.Resources.StyleSheet()
</head>
<body>
    <main>
        @{
            var customerGrid = new GridModel(DataSourceType.DuckDB, "Chinook(DuckDb)", "customer") { };
            @(await DbNetSuiteCore.Control.Create(HttpContext).Render(customerGrid))
        }
    </main>
    @DbNetSuiteCore.Resources.ClientScript()
</body>
</html>

